# Copy this file to .env and fill in your own values.
# NEVER commit the real .env to git or share it with anyone.

# --- BingX API credentials ---
# Create a key in BingX under API Management with:
# - "Perpetual Futures" trading permission ON
# - Withdrawals permission OFF (always)
# - IP whitelist set to the server this bot runs on
BINGX_API_KEY=
BINGX_API_SECRET=

# --- Market ---
SYMBOLS=BTC/USDT:USDT

# --- Timeframes -- this bot only ever looks at these three ---
WEEKLY_TIMEFRAME=1w
DAILY_TIMEFRAME=1d
ENTRY_TIMEFRAME=4h
WEEKLY_CANDLE_LIMIT=150
DAILY_CANDLE_LIMIT=200
ENTRY_CANDLE_LIMIT=300

# --- Trend (weekly + daily) ---
TREND_EMA_PERIOD=50
# Weekly trend must be clearly bullish/bearish to look for a trade at all.
REQUIRE_WEEKLY_TREND=true

# --- Daily pullback zone ---
PULLBACK_EMA_PERIOD=20
PULLBACK_TOUCH_TOLERANCE_PCT=0.5
FRACTAL_N=2

# --- 4h entry trigger ---
TRIGGER_EMA_PERIOD=9
STOP_BUFFER_PCT=0.15

# --- Reward:risk -- fixed by the strategy at 2 (config.py forces this
# regardless of what's set here; the partial-TP/trailing below usually
# manage the runner well past this before it's ever hit as a full exit) ---
REWARD_RISK_RATIO=2

# --- Risk management ---
# Hard-capped at 3% in config.py no matter what this is set to.
RISK_PCT_PER_TRADE=0.5
# Fixed collateral committed per trade; leverage is chosen automatically
# (up to the hard cap in config.py) so a stop-out never loses more than
# RISK_PCT_PER_TRADE of equity.
MARGIN_PER_TRADE_USDT=50
MAX_DAILY_LOSS_PCT=3
MAX_CONCURRENT_POSITIONS=1
# Second, independent cap: no matter how tight a stop-loss makes the
# risk-based position size, open positions combined may never require
# more than this fraction of equity*leverage in margin.
MAX_MARGIN_UTILIZATION_PCT=50
MIN_NOTIONAL_USDT=10

# --- Partial take-profit + trailing stop ---
# At 1R (the same distance as the initial risk), half the position
# closes and the stop for the rest moves to breakeven; from there the
# remainder trails with no fixed cap, instead of every winner being
# capped at the fixed 2R take-profit. Set PARTIAL_TP_FRACTION=0 to
# disable this and fall back to a fixed-2R-take-profit-only exit.
PARTIAL_TP_R_MULTIPLE=1.0
PARTIAL_TP_FRACTION=0.5
TRAIL_R_MULTIPLE=1.0

# --- Cost modeling ---
# Round-trip taker-fee estimate applied to DRY_RUN's simulated P/L only,
# so paper-trading stats aren't rosier than live trading will be. Check
# your account's actual fee tier and adjust if it differs.
DRY_RUN_FEE_PCT_PER_SIDE=0.05

# --- Safety switch: keep this "true" until you've fully validated the bot ---
DRY_RUN=true
